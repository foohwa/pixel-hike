{
  "name": "Pixel Hike",
  "short_name": "Pixel Hike",
  "description": "Turn a GPX or FIT workout into a cute pixel-art route video.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1a1c2c",
  "theme_color": "#1a1c2c",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [".gpx", ".fit", "application/gpx+xml", "application/xml", "text/xml", "application/octet-stream", "application/vnd.ant.fit", "image/jpeg", "image/png", "image/*"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": { "application/gpx+xml": [".gpx"], "application/octet-stream": [".fit"] }
    }
  ]
}
